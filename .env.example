# CredexAI Invoice Processing Agent — Environment Variables
# Copy this file to .env and fill in the values

# CredexAI Platform API
CREDEX_API_URL=https://credexai.live/api
CREDEX_API_KEY=your_credexai_api_key_here

# XRPL Configuration
XRPL_NODE_URL=https://s1.ripple.com:51234
# Leave empty for simulation mode (generates SIM_NO_XRPL_WALLET_ prefixed hashes)
XRPL_WALLET_SEED=

# Provenance Signing Key (REQUIRED — generate with: openssl rand -hex 32)
PROVENANCE_SIGNING_KEY=your_signing_key_here
